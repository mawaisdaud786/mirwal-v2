# Mirwal — root environment template. Copy to `.env`. NEVER commit a real `.env`.
#
# This repository holds four deployables, and each owns its own env file. This root file is
# NOT a combined copy of them — duplicating their variables here would give every setting two
# sources of truth that drift apart. Configure each deployable in its own file:
#
#   apps/storefront/.env   → see apps/storefront/.env.example   (mirwal.pk)
#   apps/admin/.env        → see apps/admin/.env.example        (admin.mirwal.pk)
#   apps/seller/.env       → see apps/seller/.env.example       (seller.mirwal.pk)
#   server/.env            → see server/.env.example            (the API: database, JWT
#                                                                secrets, CORS allowlist,
#                                                                cookies, rate limits,
#                                                                payment providers)
#
# Only variables read by repo-level tooling — outside any single deployable — belong here.
# Vite exposes VITE_-prefixed variables to browser code; anything without that prefix is
# build- or server-side only. Never put a secret in a VITE_ variable.

# ---------------------------------------------------------------------------
# Repo-level tooling
# ---------------------------------------------------------------------------
# Canonical production origin for scripts/generate-sitemap.mjs, which writes the storefront's
# sitemap.xml and robots.txt during its prebuild. The storefront is the only indexable
# application: admin and seller ship `noindex, nofollow` plus a blanket-disallow robots.txt.
# The script falls back to a hard-coded default when this is unset, so set it before any
# build whose output will be deployed.
SITE_URL=https://mirwal.pk
VITE_SITE_URL=https://mirwal.pk

# Convenience default for local runs of repo-level scripts. Each application still reads its
# own apps/<app>/.env at build time — this does not override them.
VITE_API_BASE_URL=http://localhost:4000/api/v1
