# ---------------------------------------------------------------------------
# Mirwal API — copy to .env and fill in. NEVER commit .env.
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
# Three origins, one per Mirwal frontend application. Never a wildcard: these endpoints
# run with credentials, so the allowlist is what stops a third-party page making
# authenticated calls as a signed-in user.
#   dev:  http://localhost:5173 (storefront), :5174 (admin), :5175 (seller)
#   prod: https://mirwal.pk,https://admin.mirwal.pk,https://seller.mirwal.pk
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# --- Database (MariaDB 10.11.x) --------------------------------------------
# Production is cPanel/CloudLinux; keep the pool small, connections are capped.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=change-me
DB_PASSWORD=change-me
DB_NAME=mirwal
DB_CONNECTION_LIMIT=10

# --- Auth -------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
REFRESH_COOKIE_NAME=mirwal_rt
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax

# --- Rate limiting ----------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
RATE_LIMIT_AUTH_MAX=10

# --- Payments ---------------------------------------------------------------
# Every provider below is OPTIONAL and independently enabled. A provider whose secrets are
# blank is reported as unavailable by GET /payments/methods and rejected at checkout — it
# never silently falls back to another method. Cash on Delivery always works and needs none
# of this.
#
# Mirwal NEVER stores card numbers, CVVs or wallet PINs. Card details go straight from the
# shopper's browser to the processor; the server only ever sees an opaque reference plus the
# brand and last four digits for display.
#
# Start with SANDBOX/TEST credentials and verify the full checkout -> pay -> webhook -> order
# marked paid flow before switching to live keys.

# Where the provider returns the shopper after an off-site redirect or 3-D Secure challenge.
# This is the FRONTEND origin, not the API's.
PAYMENT_RETURN_URL_BASE=http://localhost:5173

# Card payments (Visa/Mastercard) via Stripe. Test keys start sk_test_ / pk_test_.
# The webhook secret comes from `stripe listen` locally, or the Dashboard endpoint in prod.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# EasyPaisa merchant credentials, from your EasyPaisa merchant onboarding.
# BASE_URL is the sandbox host by default; swap to the production host when going live.
EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=
EASYPAISA_BASE_URL=https://easypaystg.easypaisa.com.pk

# JazzCash merchant credentials, from the JazzCash merchant portal.
# The integrity salt is what signs/verifies every request and callback — treat it as a secret.
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
JAZZCASH_BASE_URL=https://sandbox.jazzcash.com.pk

# Refresh cookies are issued per application and path-scoped (/api/v1/auth,
# /api/v1/admin/auth, /api/v1/seller/auth) so one application's session cookie is never
# transmitted to another's refresh endpoint. Leave REFRESH_COOKIE_DOMAIN unset unless the
# API is on a different host from the apps; in production set REFRESH_COOKIE_SECURE=true.
REFRESH_COOKIE_NAME=mirwal_rt
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax
# REFRESH_COOKIE_DOMAIN=

# --- Transactional email (SMTP) ---------------------------------------------
# Any SMTP server: your host's, Mailgun, SES, Postmark, Gmail with an app password.
# Leave SMTP_HOST blank and Mirwal sends nothing — attempts are recorded as "skipped" in the
# admin delivery log rather than reported as failures.
#   port 587 with SMTP_SECURE=false uses STARTTLS; port 465 needs SMTP_SECURE=true.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Mirwal <no-reply@mirwal.pk>
MAIL_REPLY_TO=

# --- Transactional SMS ------------------------------------------------------
# Generic HTTP gateway: Mirwal POSTs {to, from, message} with a Bearer key, so most Pakistani
# providers work without a code change. Blank disables SMS the same way as above.
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER=Mirwal

# --- Seller verification document storage -----------------------------------
# Where CNICs, tax certificates and bank letters are written. Keep this OUTSIDE any web root:
# nothing here is ever served statically, and the API streams files only to an authenticated
# owner or Mirwal staff.
UPLOAD_DIR=./storage/uploads
UPLOAD_MAX_BYTES=5242880

# --- Database exports --------------------------------------------------------
# Where the admin panel writes gzipped SQL dumps. Keep this OUTSIDE any web root: a dump is
# the entire marketplace in one file, including every address and every password hash, and it
# is only ever served through an authenticated download.
# Mirwal never uploads a backup anywhere. Copying these off the server is the operator's job.
BACKUP_DIR=./storage/backups
# Older exports are pruned once this many completed ones exist, so a backup cannot fill a disk.
BACKUP_KEEP=10

# --- Storefront URL ----------------------------------------------------------
# Used to build links in outgoing email (the password-reset link, for one). Read from here
# rather than from a request's Host header: a reset link built from a header the caller
# controls is a link that points wherever they choose, and the recipient cannot tell.
STOREFRONT_URL=http://localhost:5173
